# --- Servidor ---
PORT=8000
API_TOKEN=cambia-este-token-por-uno-largo-y-aleatorio

# --- Modelos ---
MODELS_DIR=/models
TEXT_MODEL_ID=pysentimiento/robertuito-emotion-analysis
# Visión: Emo-AffectNet (ElenaRyumina). Los pesos se descargan de Hugging Face al primer arranque.
VISUAL_REPO_ID=ElenaRyumina/face_emotion_recognition
# Pesos: backbone (ResNet50 por frame) y LSTM (temporal). Nombres de archivo dentro del repo HF.
VISUAL_BACKBONE_FILE=FER_static_ResNet50_AffectNet.pt
VISUAL_LSTM_FILE=FER_dinamic_LSTM_Aff-Wild2.pt
# Ventana temporal (frames) del LSTM; el modelo original usa 10
LSTM_WINDOW=10
# Si es true, la API arranca aunque los modelos no carguen (ready=false, 503 MODEL_UNAVAILABLE)
ALLOW_START_WITHOUT_MODELS=true

# --- Fusión e incongruencia (propuesta experimental, parametrizable) ---
DEFAULT_VISUAL_WEIGHT=0.5
INCONGRUENCE_THRESHOLD=0.70

# --- Límites ---
MAX_IMAGE_MB=5
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=60
MAX_TEXT_CHARS=5000
MAX_FRAME_BYTES=2000000
MAX_CONCURRENT_INFERENCES=2
MAX_VIDEO_JOBS_QUEUE=10
RATE_LIMIT_PER_MINUTE=60
STREAM_MAX_SECONDS=300
STREAM_TOKEN_TTL_SECONDS=60
MAX_STREAM_SESSIONS=5
JOB_RETENTION_SECONDS=3600

# --- Recursos (compose) ---
MEM_LIMIT=4g
CPU_LIMIT=2.0

# --- Otros ---
MAX_FACES=5
MAX_VIDEO_WORKERS=1
TIMELINE_SEGMENT_SECONDS=3
LOG_LEVEL=INFO

# --- Multimodal en vivo (cámara + texto) ---
LIVE_VISUAL_WINDOW_SECONDS=5
LIVE_TEXT_MIN_INTERVAL_MS=300
